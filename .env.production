# ============================================
# LMS PKBM Tunas Ilmu - Environment Variables
# ============================================
# Salin file ini ke .env dan isi nilainya

# ---------- DATABASE (PostgreSQL) ----------
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# 
# Untuk Coolify:
#   - Host: gunakan internal host dari Coolify database (biasanya: db, atau nama service)
#   - Port: 5432 (default PostgreSQL)
#   - DBName: pkbm (atau sesuai yang dibuat)
#   - User/Password: sesuai yang diatur di Coolify database
#
# Contoh:
# DATABASE_URL=postgres://pkbm:password123@db:5432/pkbm?sslmode=disable
DATABASE_URL=postgres://pkbm:YOUR_PASSWORD@db:5432/pkbm?sslmode=disable

# ---------- JWT SECRETS ----------
# Buat random string minimal 32 karakter
# Gunakan https://www.guidgenerator.com/ atau random lainnya
#
# Contoh random (GANTI DENGAN MILIK ANDA):
JWT_ACCESS_SECRET=ubah-ini-dengan-random-string-32-karakter-a1b2c3
JWT_REFRESH_SECRET=ubah-ini-dengan-random-string-32-karakter-lain-x9y8z7

# ---------- APP SETTINGS ----------
APP_ENV=production
PORT=8080

# ---------- CORS ----------
# Domain frontend yang diizinkan akses API
# Untuk Coolify: https://nama-domain-anda.com
CORS_ALLOWED_ORIGINS=https://lms-anda.com

# ---------- COOKIE ----------
# Domain untuk cookie (tanpa https://)
# Contoh: lms-anda.com
COOKIE_DOMAIN=lms-anda.com

# ---------- TURNSTILE (Opsional) ----------
# Cloudflare Turnstile untuk proteksi login
# Daftar di: https://dash.cloudflare.com/turnstile
# Kosongkan jika tidak ingin pakai
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
