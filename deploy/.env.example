DATABASE_URL=postgres://user:password@database-host:5432/pkbm?sslmode=require
# Wajib untuk service PostgreSQL bawaan docker-compose; gunakan password yang
# sama pada DATABASE_URL bila database berjalan di service `db`.
POSTGRES_DB=pkbm
POSTGRES_USER=pkbm
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_ACCESS_SECRET=replace-with-32-or-more-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-or-more-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
TURNSTILE_SECRET_KEY=replace-with-cloudflare-secret
TURNSTILE_SITE_KEY=replace-with-cloudflare-site-key
VITE_TURNSTILE_SITE_KEY=replace-with-cloudflare-site-key
CORS_ALLOWED_ORIGINS=https://your-domain
COOKIE_DOMAIN=your-domain
PUBLIC_BASE_URL=https://your-domain
N8N_PRESENSI_API_KEY=replace-with-a-long-random-automation-key

# Optional Google OAuth SSO. Provision the matching email in the LMS first.
FRONTEND_URL=https://your-domain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://your-domain/api/auth/google/callback

# Cloudflare R2 full backup (private bucket, S3 API token scoped to that bucket only)
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=pkbm-lms-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_PREFIX=pkbm-lms
BACKUP_R2_RETENTION_DAYS=36
BACKUP_R2_TIMEOUT=2m
BACKUP_MAX_ARCHIVE_MB=4096
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret
BACKUP_API_KEY=replace-with-a-long-random-read-only-automation-key
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_METHOD=PUT
BACKUP_OFFSITE_TOKEN=
BACKUP_OFFSITE_TIMEOUT=5m

# Optional operational alerts. The payload contains only backup/health metadata
# and is signed in X-PKBM-Signature-256 when a secret is supplied.
OPERATIONS_WEBHOOK_URL=https://automation.example/webhook/pkbm-operations
OPERATIONS_WEBHOOK_SECRET=replace-with-a-different-long-random-secret
OPERATIONS_WEBHOOK_TIMEOUT=5s
BACKUP_ALERT_MAX_AGE_HOURS=78
