# ============================================
# CONTOH FILE .ENV UNTUK PRODUCTION
# ============================================
# 
# CARA PAKAI:
# 1. Salin isi file ini ke .env (atau isi langsung di Coolify)
# 2. Ganti semua nilai yang bertanda "GANTI INI"
# 3. Deploy aplikasi
#
# ============================================

# ---------- DATABASE ----------
# PostgreSQL dari Coolify
# Jika pakai Coolify Database Service:
#   - Host: biasanya "db" atau nama service database
#   - User/Password: yang dibuat di Coolify
# 
DATABASE_URL=postgres://postgres:cLBbbUsgkwjtOGs01aEtTuKYLS0rGnaibH79D3KSERcfC2ZlFLMDX9yp6Eygq1wo@z88bgst5er4cevv26p5mvkd3:5432/lmspkbmti

# ---------- JWT (WAJIB DIGANTI) ----------
# Buat random string minimal 32 karakter
# Contoh: random.org/string atau guidgenerator.com
JWT_ACCESS_SECRET=GANTI_INI_DENGAN_RANDOM_STRING_32_KARAKTER_1234567890
JWT_REFRESH_SECRET=GANTI_INI_JUGA_DENGAN_RANDOM_STRING_BERBEDA_abcdef

# ---------- APP ----------
APP_ENV=production
PORT=8080

# ---------- DOMAIN (GANTI INI) ----------
# Isi dengan domain website LMS Anda
CORS_ALLOWED_ORIGINS=https://GANTI_DOMAIN_ANDA.com
COOKIE_DOMAIN=GANTI_DOMAIN_ANDA.com

# ---------- TURNSTILE (WAJIB UNTUK LOGIN PRODUCTION) ----------
# Buat site key dan secret key di Cloudflare Turnstile.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Site key yang sama untuk build frontend utama.
VITE_TURNSTILE_SITE_KEY=
